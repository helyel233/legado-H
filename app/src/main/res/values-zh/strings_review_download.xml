<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="review_download_engine">评论抓取引擎</string>
    <string name="review_download_engine_summary">自动按书源声明或页面协议特征选择。目前数据接口支持 idea_comment 段评及楼中楼；章评、书评自动选择网页。自动模式下数据接口抓取失败会回退网页快照；强制数据接口但当前评论类型不支持时同样回退网页，并记录日志。</string>
    <string name="review_download_data_concurrency">评论数据请求并发数</string>
    <string name="review_download_reply_concurrency">楼中楼请求并发数</string>
    <string name="review_download_resource_concurrency">离线资源请求并发数</string>
    <string name="review_download_page_concurrency">网页快照页面并发数</string>
    <string name="review_download_heavy_concurrency">快照重处理并发数</string>
    <string name="review_download_page_size">评论每页请求数量</string>
    <string name="review_download_reply_size">回复每页请求数量</string>
    <string name="review_download_stable_interval">网页稳定检测间隔（毫秒）</string>
    <string name="review_download_stable_rounds">网页稳定确认轮数</string>
    <string name="review_download_page_timeout">网页加载与展开超时（毫秒）</string>
    <string name="review_download_data_timeout">评论数据请求超时（毫秒）</string>
    <string name="review_download_resource_timeout">离线资源请求超时（毫秒）</string>
    <string name="review_download_retries">请求失败重试次数</string>
    <string name="review_download_retry_interval">请求重试基础间隔（毫秒）</string>
    <string name="review_download_backoff">请求重试退避方式</string>
    <string name="review_download_reuse_replies">复用接口内嵌完整回复</string>
    <string name="review_download_reuse_resources">复用已缓存公共资源</string>
    <string name="review_download_require_avatars">头像失败标记部分快照</string>
    <string name="review_download_require_images">评论图片失败标记部分快照</string>
    <string name="review_download_require_css">样式表失败标记部分快照</string>
    <string name="review_download_require_fonts">字体候选全部失败标记部分快照</string>
    <string name="review_download_requirement_summary">关闭后仍保留失败记录和缺失数量，但此类资源失败不影响任务成功。关闭缓存该类内容时不发起请求。</string>
    <string name="review_download_protocol">评论数据协议（snapshotProtocol：留空自动识别；idea_comment 支持段评及楼中楼）</string>
    <string name="cache_review_replies">缓存楼中楼回复</string>
    <string name="cache_review_replies_summary">关闭后所有评论快照（段评、章评、书评）都不包含回复层；章评按章、书评整本各只缓存一份，不受此开关影响。</string>
    <string name="cache_review_avatars">缓存评论者头像</string>
    <string name="cache_review_images">缓存评论图片</string>
    <string name="compress_review_avatars">压缩评论者头像</string>
    <string name="compress_review_images">压缩评论图片</string>
    <string name="compress_review_images_summary">超过上限时压缩后再写入离线资源库，减小缓存体积；仅影响新写入的资源，关闭后保留原图。</string>
    <string name="review_avatar_compression_max">头像压缩上限（KiB）</string>
    <string name="review_image_compression_max">评论图片压缩上限（KiB）</string>
    <string name="review_compression_max_summary">当前：%1$d KiB；默认：%2$d KiB。%3$s</string>
    <string name="cache_review_resource_summary">写入离线资源库；关闭后快照内仍保留原始地址，离线查看时无法显示。</string>
    <string name="review_download_numeric_summary">当前：%1$d；默认：%2$d。%3$s</string>
    <string name="review_download_help_avatar_compression">头像超过该大小才会压缩；阈值过小会明显降低清晰度。</string>
    <string name="review_download_help_image_compression">评论内图片超过该大小才会压缩；设为较小值可显著减小离线资源库。</string>
    <string name="review_download_help_data">数据协议请求使用此配额，与回复、资源、网页分开；当前支持 idea_comment 段评，章评、书评走网页。</string>
    <string name="review_download_help_page_size">单次请求的条数参数；仍按服务端游标取完全部页面。服务端实际返回数量会记录。</string>
    <string name="review_download_help_replies">所有楼中楼数据请求共享此配额，不占用评论数据请求配额。</string>
    <string name="review_download_help_reply_size">回复单页请求条数；不限制回复总量。</string>
    <string name="review_download_help_reuse_replies">接口内嵌回复已完整时直接保存；关闭后从回复接口重新取全。</string>
    <string name="review_download_help_pages">同时加载、展开的传统网页数量；结构化数据不占用此阶段。</string>
    <string name="review_download_help_stable_interval">只作用于传统网页展开和稳定检测；0 表示不主动等待。</string>
    <string name="review_download_help_stable_rounds">传统网页连续多少轮内容稳定才结束；数据接口按明确完成状态结束。</string>
    <string name="review_download_help_resources">全局资源请求并发，含头像、评论图片、样式表和字体；不再按每个页面分别建配额。</string>
    <string name="review_download_help_reuse_resources">按准确 URL 和图片处理要求复用资源；关闭后重新下载。失败不会当作缓存命中。</string>
    <string name="review_download_help_heavy">资源改写、图片压缩、HTML 序列化与快照提交；网络等待不占用此配额。</string>
    <string name="review_download_help_page_timeout">传统网页加载和展开的总时间；0 表示不设超时。网页失败直接报告，不自动换引擎。</string>
    <string name="review_download_help_data_timeout">一次数据请求（含正文读取）的总时间；0 表示不设超时。</string>
    <string name="review_download_help_resource_timeout">一次资源请求（含文件传输）的总时间；0 表示不设超时。</string>
    <string name="review_download_help_retries">数据及资源 HTTP 请求初次失败后额外重试次数；0 不重试。每次失败、重试均记录，取消不重试。</string>
    <string name="review_download_help_retry_interval">基础等待时间；0 不主动等待。</string>
    <string name="review_download_help_requirement_fonts">同一字体按 CSS 候选关系取可用格式；全部候选失败才触发此项。%1$s</string>
    <string-array name="review_download_engine_entries"><item>自动按协议能力选择</item><item>强制数据接口</item><item>强制网页快照</item></string-array>
    <string-array name="review_download_engine_values"><item>auto</item><item>data</item><item>web</item></string-array>
    <string-array name="review_download_backoff_entries"><item>固定间隔</item><item>线性增长</item><item>指数增长</item></string-array>
    <string-array name="review_download_backoff_values"><item>fixed</item><item>linear</item><item>exponential</item></string-array>
</resources>
