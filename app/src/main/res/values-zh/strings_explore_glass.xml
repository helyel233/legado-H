<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="explore_glass_settings_title">全局毛玻璃效果</string>
    <string name="explore_glass_settings_summary">调整顶栏与发现页毛玻璃的材质预设、微调与渲染方式</string>

    <string name="explore_glass_section_effect">玻璃效果</string>
    <string name="explore_glass_section_advanced">渲染与兼容</string>

    <string name="explore_glass_effect_mode">材质样式</string>
    <string name="explore_glass_effect_mode_summary">与底栏「常规 / 玻璃 / 磨砂玻璃」共用同一套预设参数；下方滑杆仅在该档原值上微调</string>
    <string name="explore_glass_mode_none">无玻璃</string>
    <string name="explore_glass_mode_glass">透明玻璃</string>
    <string name="explore_glass_mode_frosted">磨砂玻璃</string>

    <string name="explore_glass_level">玻璃强度</string>
    <string name="explore_glass_level_summary">全局玻璃强度按日间/夜间分别保存；玻璃档 0 为关闭，无玻璃档不受影响</string>

    <string name="explore_glass_blur_scale">模糊程度</string>
    <string name="explore_glass_blur_scale_summary">100 为该档预设经书源名行标定后的原值，0 最弱，200 加倍；同时作用于硬件真高斯与软件模糊</string>

    <string name="explore_glass_shell_scale">底色遮盖</string>
    <string name="explore_glass_shell_scale_summary">100 为该档预设经书源名行标定后的三色壳层原值，控制书源名行底色浓度，数值越大文字与壁纸分离越彻底</string>

    <string name="explore_glass_tint_scale">白色着色</string>
    <string name="explore_glass_tint_scale_summary">100 为该档预设经书源名行标定后的着色原值，控制玻璃表面的白色弱着色，数值越大表面越亮</string>

    <string name="explore_glass_stroke_scale">边缘描边</string>
    <string name="explore_glass_stroke_scale_summary">100 为该档预设经书源名行标定后的描边原值，控制圆角边缘描边的明显程度，数值越大轮廓越清晰</string>

    <string name="explore_glass_hardware_blur">硬件真高斯</string>
    <string name="explore_glass_hardware_blur_summary">Android 12 及以上可用；关闭后强制走已验证的软件模糊降级管线</string>

    <string name="explore_glass_animated_solid">动图壁纸使用纯色底</string>
    <string name="explore_glass_animated_solid_summary">开启时动图壁纸不采样静止首帧，避免「壁纸在动、玻璃不动」；关闭后可接受静止首帧玻璃</string>

    <string name="explore_glass_restore_defaults">恢复默认</string>
    <string name="explore_glass_restore_defaults_summary">清除本页全部设置，包括材质档位与玻璃强度的日间、夜间取值</string>

    <string-array name="explore_glass_mode_entries">
        <item>无玻璃</item>
        <item>透明玻璃</item>
        <item>磨砂玻璃</item>
    </string-array>
    <string-array name="explore_glass_mode_values">
        <item>solid</item>
        <item>glass</item>
        <item>frosted</item>
    </string-array>
    <string-array name="explore_glass_mode_descriptions">
        <item>贴主题底色的完全不透明纯色块：不透壁纸、不绘制玻璃层；玻璃强度、墨水屏与低内存设置都不改变它</item>
        <item>与底栏「玻璃」一致：8 + 强度 × 10dp 轻模糊、0.02 + 强度 × 0.05 弱着色，色散/折射更强；在书源名行上表现为更薄的底色遮盖、更亮的边缘高光</item>
        <item>与底栏「磨砂玻璃」一致：12 + 强度 × 18dp 模糊、0.05 + 强度 × 0.10 着色；在书源名行上表现为更奶白厚实的底色遮盖、更柔和的边缘高光</item>
    </string-array>
</resources>
